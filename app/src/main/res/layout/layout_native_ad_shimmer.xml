<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_view_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:shimmer_auto_start="true"
    app:shimmer_duration="1200">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFF0F5"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- Skeleton Badge Ad -->
            <View
                android:id="@+id/shimmer_badge"
                android:layout_width="24dp"
                android:layout_height="14dp"
                android:background="#E0E0E0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Skeleton Icon -->
            <View
                android:id="@+id/shimmer_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="#E0E0E0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/shimmer_badge" />

            <!-- Skeleton Headline -->
            <View
                android:id="@+id/shimmer_headline"
                android:layout_width="160dp"
                android:layout_height="16dp"
                android:layout_marginStart="10dp"
                android:background="#E0E0E0"
                app:layout_constraintStart_toEndOf="@id/shimmer_icon"
                app:layout_constraintTop_toTopOf="@id/shimmer_icon" />

            <!-- Skeleton Body -->
            <View
                android:id="@+id/shimmer_body"
                android:layout_width="200dp"
                android:layout_height="12dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="6dp"
                android:background="#E0E0E0"
                app:layout_constraintStart_toEndOf="@id/shimmer_icon"
                app:layout_constraintTop_toBottomOf="@id/shimmer_headline" />

            <!-- Skeleton MediaView -->
            <View
                android:id="@+id/shimmer_media"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="10dp"
                android:background="#E0E0E0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/shimmer_icon" />

            <!-- Skeleton Button -->
            <View
                android:id="@+id/shimmer_button"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:background="#E0E0E0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/shimmer_media" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</com.facebook.shimmer.ShimmerFrameLayout>
