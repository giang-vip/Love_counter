<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 1. ẢNH NỀN HOÀNG HÔN -->
    <ImageView
        android:id="@+id/imgTopBackground"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:scaleType="centerCrop"
        android:src="@drawable/backgroud_home1"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Icon Cài đặt -->
    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:padding="8dp"
        android:src="@drawable/ic_settings_02"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Icon Thư viện ảnh -->
    <ImageView
        android:id="@+id/btnGallery"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="32dp"
        android:padding="8dp"
        android:src="@drawable/icon_anh"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. NỀN TRẮNG BÊN DƯỚI -->
    <View
        android:id="@+id/viewWhiteBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-40dp"
        android:background="@drawable/backgroud_home2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgTopBackground"
        app:layout_constraintVertical_bias="0.0" />

    <!-- 3. ẢNH CẶP ĐÔI CHÍNH -->
    <ImageView
        android:id="@+id/imgMainCouple"
        android:layout_width="220dp"
        android:layout_height="150dp"
        android:src="@drawable/img_couple"
        app:layout_constraintBottom_toTopOf="@id/viewWhiteBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/viewWhiteBackground" />

    <!-- 4. THÔNG TIN BẠN NAM (BÊN TRÁI) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgAvatarMale"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:layout_marginTop="24dp"
        android:scaleType="centerCrop"
        android:src="@drawable/img_avata_male"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Circle"
        app:layout_constraintEnd_toStartOf="@id/layoutHeartCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgMainCouple" />

    <TextView
        android:id="@+id/tvNameMale"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/tv_sasuke"
        android:textColor="#333333"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/imgAvatarMale"
        app:layout_constraintStart_toStartOf="@id/imgAvatarMale"
        app:layout_constraintTop_toBottomOf="@id/imgAvatarMale" />

    <TextView
        android:id="@+id/tvAgeMale"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/tv_26"
        android:textColor="#666666"
        android:textSize="12sp"
        app:drawableStartCompat="@drawable/ic_male"
        app:layout_constraintEnd_toEndOf="@id/tvNameMale"
        app:layout_constraintStart_toStartOf="@id/tvNameMale"
        app:layout_constraintTop_toBottomOf="@id/tvNameMale" />

    <!-- 5. TRÁI TIM ĐẾM NGÀY YÊU (Ở GIỮA) -->

    <!-- 6. THÔNG TIN BẠN NỮ (BÊN PHẢI) -->

    <LinearLayout
        android:id="@+id/layoutHeartCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginTop="30dp"
        app:layout_constraintBottom_toBottomOf="@id/imgAvatarMale"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/imgAvatarMale">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="85dp"
                android:layout_height="85dp"
                android:src="@drawable/img_heart_home" />

            <TextView
                android:id="@+id/tvDaysCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="0\nDay"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tv_tap_to_start_date"
            android:textColor="#888888"
            android:textSize="11sp" />
    </LinearLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgAvatarFemale"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:scaleType="centerCrop"
        android:src="@drawable/img_avata_female"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/layoutHeartCenter"
        app:layout_constraintTop_toTopOf="@id/imgAvatarMale" />

    <TextView
        android:id="@+id/tvNameFemale"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/tv_naruto"
        android:textColor="#333333"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/imgAvatarFemale"
        app:layout_constraintStart_toStartOf="@id/imgAvatarFemale"
        app:layout_constraintTop_toBottomOf="@id/imgAvatarFemale" />

    <TextView
        android:id="@+id/tvAgeFemale"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/tv_26"
        android:textColor="#666666"
        android:textSize="12sp"
        app:drawableStartCompat="@drawable/ic_female"
        app:layout_constraintEnd_toEndOf="@id/tvNameFemale"
        app:layout_constraintStart_toStartOf="@id/tvNameFemale"
        app:layout_constraintTop_toBottomOf="@id/tvNameFemale" />


</androidx.constraintlayout.widget.ConstraintLayout>