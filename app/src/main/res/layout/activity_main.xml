<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.splash.MainActivity">

<!-- khung chứa logo và chữ-->
    <!-- Khung chứa logo và chữ -->
<!--    android:background="@drawable/bg_logo_border"-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutlogo"
        android:layout_width="wrap_content"
        android:layout_height="120dp"


        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.35">


        <!-- Ô logo -->
        <View
            android:id="@+id/logo"
            android:layout_width="72dp"
            android:layout_height="70dp"
            android:background="@drawable/bg_logo_icon"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- LOVE -->
        <TextView
            android:id="@+id/tvLove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/textLOVE"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold|italic"
            android:fontFamily="@font/pacifico_regular"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="2dp"

            app:layout_constraintBottom_toBottomOf="parent"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvCounter"

            app:layout_constraintHorizontal_chainStyle="packed" />


        <!-- COUNTER -->
        <TextView
            android:id="@+id/tvCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="@string/textCOUNTER"
            android:textColor="@color/text_counter"
            android:textSize="20sp"
            android:textStyle="bold|italic"
            android:fontFamily="@font/pacifico_regular"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingEnd="8dp"

            app:layout_constraintStart_toEndOf="@id/tvLove"
            app:layout_constraintEnd_toEndOf="parent"

            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Phần loading 4 chấm -->
    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 4 dots -->
        <LinearLayout
            android:id="@+id/layoutDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot1"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_dot_active" />

            <View
                android:id="@+id/dot2"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_dot" />

            <View
                android:id="@+id/dot3"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_dot" />

            <View
                android:id="@+id/dot4"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:layout_marginHorizontal="3dp"
                android:background="@drawable/bg_dot" />

        </LinearLayout>

        <!-- Text quảng cáo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tv_ads_notice"
            android:textColor="#6E7480"
            android:textSize="15sp" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>