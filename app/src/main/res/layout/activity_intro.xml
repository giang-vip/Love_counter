<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFD"
    tools:context=".ui.intro.IntroActivity">

    <!-- Vùng nội dung cuộn linh hoạt chống đè nút -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        app:layout_constraintBottom_toTopOf="@id/nativeAdContainer"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ViewPager2 ẢNH INTRO -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerIntro"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- TITLE -->
            <TextView
                android:id="@+id/tvIntroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Test Your Relationship"
                android:textColor="#252632"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/viewPagerIntro" />

            <!-- DESCRIPTION -->
            <TextView
                android:id="@+id/tvIntroDescription"
                android:layout_width="270dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Find out your love compatibility with your partner"
                android:textColor="#6E7480"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvIntroTitle" />

            <!-- THANH ĐIỀU HƯỚNG DƯỚI (DOTS + NEXT) -->
            <LinearLayout
                android:id="@+id/layoutBottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvIntroDescription">

                <!-- DOT 1 -->
                <View
                    android:id="@+id/dot1"
                    android:layout_width="14dp"
                    android:layout_height="5dp"
                    android:background="@drawable/bg_dot_active" />

                <!-- DOT 2 -->
                <View
                    android:id="@+id/dot2"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_dot" />

                <!-- DOT 3 -->
                <View
                    android:id="@+id/dot3"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_dot" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- NEXT BUTTON -->
                <TextView
                    android:id="@+id/tvNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Next"
                    android:textColor="#252632"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Khung chứa Native Ad cố định mép dưới màn hình -->
    <FrameLayout
        android:id="@+id/nativeAdContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
