    <!-- Name Test Descriptions -->
    <string name="name_test_desc_1">Nam nữ hút nhau! Dù tính cách khác biệt, sự kiên nhẫn và thấu hiểu sẽ giúp hai bạn xây dựng tình yêu bền chặt.</string>
    <string name="name_test_desc_2">Có một tia lửa tình yêu giữa hai bạn! Hãy trò chuyện cởi mở và dành thời gian bên nhau để tình yêu nở hoa rực rỡ.</string>
    <string name="name_test_desc_3">Cặp đôi tuyệt vời! Hai bạn có sự kết nối sâu sắc và tôn trọng lẫn nhau. Hãy tiếp tục vun đắp tình yêu này nhé!</string>
    <string name="name_test_desc_4">Cặp đôi trời sinh! Tâm hồn hai bạn cùng chung một tần số. Hai bạn thực sự sinh ra là để dành cho nhau!</string>

