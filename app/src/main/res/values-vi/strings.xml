    <!-- Horoscope Descriptions -->
    <string name="horoscope_desc_1">Mọi thứ dễ trở nên hỗn loạn vì hai bên khó đặt niềm tin trọn vẹn vào nhau...</string>
    <string name="horoscope_desc_2">Trong tình yêu, cả hai cùng nỗ lực vì đối phương nhưng đôi khi cảm thấy kiệt sức...</string>
    <string name="horoscope_desc_3">Nhìn chung cả hai đều bướng bỉnh theo cách riêng, cần thêm sự kiên nhẫn và bao dung...</string>
    <string name="horoscope_desc_4">Mối quan hệ không quá nồng nhiệt nhưng bình yên, cùng nhau vun đắp tình cảm mỗi ngày...</string>
    <string name="horoscope_desc_5">Một tình yêu đẹp đẽ, êm đềm và hòa hợp như mặt biển bình yên...</string>
    <string name="horoscope_desc_6">Yêu nhau theo cách riêng, bảo vệ che chở nhau từ những điều nhỏ nhặt nhất...</string>
    <string name="horoscope_desc_7">Hai bạn có vô vàn điểm chung, bị thu hút mạnh mẽ bởi sự đồng điệu và đam mê...</string>

