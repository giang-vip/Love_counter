<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shimmerContainerNative"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/size12"
    android:visibility="visible"
    app:layout_constraintTop_toTopOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/cta"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size44"
            android:layout_marginTop="@dimen/_16sdp"
            android:background="@color/home_shimmer_color"
            android:gravity="center"
            android:lines="1"
            android:textColor="@color/gnt_white"
            android:textSize="@dimen/size14"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_min="@dimen/size40"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/middle" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/middle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/icon"
                android:layout_width="@dimen/size48"
                android:layout_height="@dimen/size48"
                android:background="@color/home_shimmer_color"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@tools:sample/avatars" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/appCompatTextView5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_ad_view_v3"
                android:backgroundTint="@color/home_shimmer_color"
                android:paddingHorizontal="@dimen/size5"
                android:text="Ad"
                android:textColor="@color/gnt_white"
                android:textSize="@dimen/size10"
                android:layout_marginStart="@dimen/size9"
                android:fontFamily="@font/sf_medium"
                app:layout_constraintStart_toEndOf="@+id/icon"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/primary"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/size5"
                android:layout_height="@dimen/size15"
                android:layout_marginStart="@dimen/size9"
                android:background="@color/home_shimmer_color"
                android:textColor="@color/gnt_gray"
                android:textSize="@dimen/size15"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/icon"
                app:layout_constraintTop_toBottomOf="@+id/appCompatTextView5" />

            <View
                android:id="@+id/secondary"
                android:layout_marginTop="@dimen/size5"
                android:layout_width="0dp"
                android:layout_height="@dimen/size45"
                android:layout_marginStart="@dimen/size9"
                android:background="@color/home_shimmer_color"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/icon"
                app:layout_constraintTop_toBottomOf="@+id/primary" />

        </androidx.constraintlayout.widget.ConstraintLayout>






    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
