<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gnt_outline_shape"
    android:paddingTop="@dimen/size30">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ad_unit_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:srcCompat="@drawable/bg_ads_full_screen" />


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAdView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size8"
            android:background="@drawable/shape_ad_view_v3"
            android:fontFamily="@font/sf_medium"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/size5"
            android:paddingVertical="@dimen/size2"
            android:text="Ad"
            android:textColor="@color/white"
            android:textSize="@dimen/size8"
            app:layout_constraintBottom_toBottomOf="@+id/ad_headline"
            app:layout_constraintStart_toEndOf="@+id/ad_app_icon"
            app:layout_constraintTop_toTopOf="@+id/ad_headline" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ad_call_to_action"
            android:layout_width="0dp"
            android:layout_height="@dimen/size48"
            android:layout_marginHorizontal="@dimen/size8"
            android:layout_marginBottom="@dimen/size16"
            android:background="@drawable/shape_cta_native_admob"
            android:fontFamily="@font/chakra_petch_semi_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lines="1"
            android:textColor="#4D3405"
            android:textSize="@dimen/size16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_min="@dimen/size40"
            app:layout_constraintStart_toStartOf="parent" />


        <TextView
            android:id="@+id/ad_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/size16"
            android:ellipsize="end"
            android:fontFamily="@font/sf_regular"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="#131316"
            android:textSize="@dimen/size12"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@+id/ad_call_to_action"
            app:layout_constraintEnd_toEndOf="@+id/ad_call_to_action"
            app:layout_constraintStart_toEndOf="@+id/ad_app_icon"
            tools:text="@tools:sample/lorem/random" />

        <ImageView
            android:id="@+id/ad_app_icon"
            android:layout_width="@dimen/size55"
            android:layout_height="@dimen/size55"
            android:layout_marginStart="@dimen/size8"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ad_headline"
            tools:src="@tools:sample/avatars" />

        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/size2"
            android:ellipsize="end"
            android:fontFamily="@font/sf_medium"
            android:includeFontPadding="false"
            android:lines="1"
            android:textColor="#131316"
            android:textSize="@dimen/size14"
            app:layout_constraintBottom_toTopOf="@+id/ad_body"
            app:layout_constraintEnd_toEndOf="@+id/ad_call_to_action"
            app:layout_constraintStart_toEndOf="@+id/tvAdView"
            tools:text="Nhận học bổng du học Mỹ" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.gms.ads.nativead.NativeAdView>